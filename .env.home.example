# Variáveis do compose de casa (docker-compose.home.yaml): painel, coletor, banco e backup, usando
# o broker que já roda no Coolify, com o login único dele. No Coolify, cadastre-as em
# "Environment Variables" do recurso. Guia completo: docs/deploy.md

# ---- Banco: gere com `openssl rand -hex 24` --------------------------------------------------------
# Vale só na primeira subida, quando o volume do banco é criado.
POSTGRES_PASSWORD=

# ---- Broker ---------------------------------------------------------------------------------------
# Login único do broker: os valores de SERVICE_USER_MOSQUITTO e SERVICE_PASSWORD_MOSQUITTO do
# serviço do broker no Coolify. As estações usam o mesmo login.
MQTT_USERNAME=
MQTT_PASSWORD=
# Como o coletor e o painel chegam ao broker: mesmo servidor, pela rede coolify.
MQTT_URL=mqtt://mosquitto:1883

# ---- Painel ---------------------------------------------------------------------------------------
# Endereço público do painel, como o navegador o abre (com https).
APP_URL=https://estacao.seudominio.com.br
# Primeiro administrador: criado só enquanto não houver nenhum usuário (mínimo de 10 caracteres
# na senha). Depois do primeiro acesso, troque a senha em "Meu perfil".
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador

# ---- Estações -------------------------------------------------------------------------------------
# Endereço e porta que as estações usam para chegar ao broker: o nome do DDNS de casa, com o
# port forward do roteador levando a porta até o servidor. Aparecem no painel ao cadastrar.
PUBLIC_MQTT_HOST=
PUBLIC_MQTT_PORT=1883

# ---- Outros ---------------------------------------------------------------------------------------
LOG_LEVEL=info
# Fuso e hora (0 a 23) do backup diário do banco.
BACKUP_TZ=America/Sao_Paulo
BACKUP_HOUR=3
