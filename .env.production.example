# Variáveis da produção (docker-compose.yaml). No Coolify, cadastre-as em "Environment Variables"
# do recurso; sem o Coolify, copie este arquivo para .env ao lado do compose e preencha.
# Guia completo: docs/deploy.md

# ---- Senhas: gere cada uma com `openssl rand -hex 24` ---------------------------------------------
# Só letras e números: a senha do banco entra na URL de conexão dos apps.
POSTGRES_PASSWORD=
# Cliente "admin" do Mosquitto (Dynamic Security), usado pelo painel. Mínimo de 12 caracteres.
MOSQUITTO_DYNSEC_PASSWORD=
# Cliente "collector" do Mosquitto: o painel o cria no broker ao subir.
MQTT_COLLECTOR_PASSWORD=

# ---- Painel ---------------------------------------------------------------------------------------
# Endereço público do painel, como o navegador o abre (com https).
APP_URL=https://estacao.seudominio.com.br
# Primeiro administrador: criado só enquanto não houver nenhum usuário (mínimo de 10 caracteres
# na senha). Depois do primeiro acesso, troque a senha em "Meu perfil".
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador

# ---- MQTT das estações (sem TLS, design §3.10) ----------------------------------------------------
# Endereço que as estações usam para chegar ao broker: um registro DNS sem o proxy da Cloudflare
# ("DNS only", nuvem cinza) apontando para o servidor, ou o IP público dele.
PUBLIC_MQTT_HOST=mqtt.seudominio.com.br
# Porta que as estações usam (mostrada no painel ao cadastrar uma estação).
PUBLIC_MQTT_PORT=1883
# Porta publicada no servidor. Mude só se a 1883 já estiver ocupada (no teste em casa, por exemplo,
# 1884 com o port forward do roteador levando a porta externa até ela).
MQTT_HOST_PORT=1883

# ---- Outros ---------------------------------------------------------------------------------------
LOG_LEVEL=info
# Fuso e hora (0 a 23) do backup diário do banco.
BACKUP_TZ=America/Sao_Paulo
BACKUP_HOUR=3
