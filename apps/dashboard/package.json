{
  "name": "@wx/dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "App 2 — dashboard: Fastify API (src/server) and React SPA (src/web).",
  "type": "module",
  "scripts": {
    "dev": "pnpm run \"/^dev:(server|web)$/\"",
    "dev:server": "tsx watch --env-file-if-exists=../../.env src/server/main.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "tsx --env-file-if-exists=../../.env src/server/main.ts",
    "typecheck": "tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.e2e.json",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.7",
    "@fontsource-variable/archivo": "^5.3.0",
    "@node-rs/argon2": "^2.2.2",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@tanstack/react-query": "^5.104.5",
    "@wx/db": "workspace:*",
    "@wx/mqtt-admin": "workspace:*",
    "@wx/shared": "workspace:*",
    "echarts": "^6.1.0",
    "fastify": "^5.12.7",
    "fastify-plugin": "^6.0.1",
    "lucide-react": "^1.61.0",
    "maplibre-gl": "^6.15.0",
    "mqtt": "^5.16.1",
    "pino": "^10.4.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0",
    "three": "^0.186.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "pino-pretty": "^13.2.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.5"
  }
}
