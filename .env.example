# Copie para .env (cp .env.example .env). Os valores abaixo servem para DESENVOLVIMENTO.
# Em produção, gere senhas fortes (ver docs de deploy).

# ---- Infra de desenvolvimento (infra/compose.dev.yml) -----------------------------------
# Porta local do Postgres de dev (5432 costuma estar ocupada por um Postgres instalado na máquina)
DEV_POSTGRES_PORT=5442
DEV_MQTT_PORT=1883

POSTGRES_USER=weather
POSTGRES_PASSWORD=weather-dev-password
POSTGRES_DB=weather

# ---- Banco ---------------------------------------------------------------------------------
DATABASE_URL=postgres://weather:weather-dev-password@127.0.0.1:5442/weather
# Banco usado pelos testes de integração (criado automaticamente pelo compose de dev)
TEST_DATABASE_URL=postgres://weather:weather-dev-password@127.0.0.1:5442/weather_test

# ---- MQTT (Mosquitto + Dynamic Security) ------------------------------------------------------
# Senha do cliente "admin", criado pelo próprio Mosquitto no primeiro start (mínimo 12 caracteres)
MOSQUITTO_DYNSEC_PASSWORD=dev-admin-password
MQTT_URL=mqtt://127.0.0.1:1883
MQTT_ADMIN_USERNAME=admin
# Senha do cliente "collector" (criado pelo bootstrap: pnpm mqtt:bootstrap)
MQTT_COLLECTOR_PASSWORD=dev-collector-password

# ---- Geral -----------------------------------------------------------------------------------
LOG_LEVEL=info
